# Never commit .env. MongoDB should listen on loopback or a private network.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=levelup_results
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Preferred: npm run admin:set (interactive, hashed into MongoDB).
# Optional first-run bootstrap; existing admin passwords are not overwritten.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
STUDENT_ACCESS_MODE=name
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Production: exact number of trusted reverse proxies; direct app port must be private.
TRUST_PROXY_HOPS=1
